# Copy this file to config/site.env and adapt it to the local installation.
# config/site.env is ignored by Git. Never put STAR_POD_KEY in this file.

# Executable command names are resolved through PATH. An absolute path can be
# supplied on sites that do not expose these commands through environment
# modules or the login shell.
STAR_EXECUTABLE=starccm+
APPTAINER_EXECUTABLE=apptainer

# Until BootstrapCase.java is implemented, this prepared simulation is a
# required local input and remains ignored by Git.
STAR_TEMPLATE=star/naca0012_periodic_template.sim

STAR_NP=1
RANS_NP=1

# Supported values: default, power-on-demand. Power-on-Demand prompts securely
# at runtime and does not store its key in this repository.
STAR_LICENSE_MODE=default

# Supported values: auto, docker, apptainer.
NEKTAR_CONTAINER_RUNTIME=auto

# Optional rsync/SSH helper settings. REMOTE_HOST may be an SSH config alias or
# a user@hostname target. REMOTE_DIR must be relative to the remote home.
REMOTE_HOST=
REMOTE_DIR=nektar-star-pipeline
