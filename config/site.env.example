# Copy this file to config/site.env and adapt it to the local installation.
# config/site.env is ignored by Git. Never put STAR_POD_KEY in this file.

# Executable command names are resolved through PATH. An absolute path can be
# supplied on sites that do not expose these commands through environment
# modules or the login shell.
STAR_EXECUTABLE=starccm+
APPTAINER_EXECUTABLE=apptainer

# The default case bootstraps this ignored STAR template from STAR_STEP. Clear
# STAR_STEP to reuse an existing prepared template instead.
STAR_TEMPLATE=star/naca0012_periodic_template.sim
STAR_STEP=cad/naca0012_domain.step

# One rank count drives STAR meshing, STAR RANS, the Nektar++ solver and the
# parallel-capable WSS/pressure-extraction operations invoked by execute.sh.
# It is also the fallback default for every individual stage script's own
# --np/--star-np flag (run_star_mesh.sh, run_star_rans.sh,
# run_star_bootstrap.sh, run_remote_pipeline.sh, run_resolution_study.sh,
# run_nektar_solver.sh) when invoked directly with MPI_NP exported, so an
# explicit --np/--star-np is only needed to override it per stage. The
# wall-shear-specific rank counts (run_nektar_solver.sh --wall-shear-np and
# postprocess_wall_shear.sh --np) deliberately keep their own default of 1
# regardless of MPI_NP; Nektar++ 5.10.0 is only validated there at N=1.
MPI_NP=1

# Nektar++ solver and mean-field post-processing run automatically after the
# mesh/restart pipeline. Parallel WSS remains version-sensitive and its
# finite-value gate will reject a corrupt result.
NEKTAR_SOLVER_STEPS=100
NEKTAR_WING_BOUNDARY=0
NEKTAR_SESSION=nektar/naca0012-periodic/session.xml
NEKTAR_RUN_DIR=nektar/naca0012-periodic/run

# Supported values: default, power-on-demand. Power-on-Demand prompts securely
# at runtime and does not store its key in this repository.
STAR_LICENSE_MODE=default

# Supported values: auto, docker, apptainer.
NEKTAR_CONTAINER_RUNTIME=auto

# Optional full Nektar++ OCI image override. One image supplies NekMesh,
# FieldConvert and IncNavierStokesSolver. Leave empty to use the pinned latest
# stable release defined in scripts/nektar/container_images.sh.
NEKTAR_CONTAINER_IMAGE=

# Optional rsync/SSH helper settings. REMOTE_HOST may be an SSH config alias or
# a user@hostname target. REMOTE_DIR must be relative to the remote home.
REMOTE_HOST=
REMOTE_DIR=nektar-star-pipeline
