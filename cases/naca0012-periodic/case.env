# Version-controlled parameters for the validated periodic NACA0012 tutorial.
# Machine paths, MPI allocation and licensing belong in config/site.env.

CASE_NAME=naca0012_periodic_full

# Composite order produced by the scripted STEP-to-SIM bootstrap after all
# airfoil faces (including the blunt trailing edge) are merged into Wing.
# Prepared GUI templates may differ.
PERIODIC_SURF1=6
PERIODIC_SURF2=8
PERIODIC_DIR=z
PERIODIC_TRANSLATION_X=0.0
PERIODIC_TRANSLATION_Y=0.0
PERIODIC_TRANSLATION_Z=0.2
STAR_PERIODIC_INTERFACE=SpanwisePeriodic

# Nondimensional flow convention shared by STAR and Nektar++:
# U_inf=1, rho=1, chord=1, and mu=nu=1/Re.
RANS_REYNOLDS=100
RANS_MAX_STEPS=2000
RANS_MIN_STEPS=500
RANS_RESIDUAL_TOL=3e-3
# Accept the exported donor field at RANS_MAX_STEPS even if one normalized
# residual has plateaued above RANS_RESIDUAL_TOL. This is appropriate here
# only because the one-macro-prism mesh is an interoperability precursor.
RANS_ALLOW_UNCONVERGED=true
RANS_NUM_MODES=5

# Set to true to skip the STAR RANS solve and its CSV-to-FLD interpolation
# entirely and initialize the Nektar++ solver with a uniform inflow instead
# (u=1, v=0, w=0). RANS_REYNOLDS is still used for the solver's Kinvis in
# either case.
UNIFORM_INFLOW=true

CAD_ORDER=4
BL_SURFACE=4
BL_LAYERS=8
BL_RATIO=1.2
